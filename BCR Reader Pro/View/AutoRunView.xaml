<Page x:Class="BCR_Reader_Pro.View.AutoRunView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:BCR_Reader_Pro.View"
      xmlns:svc="clr-namespace:BCR_Reader_Pro.Service"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AutoRunView"
      Background="White">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <StackPanel  Grid.Row="1" Orientation="Horizontal">
            <Button HorizontalAlignment="Stretch" Content="시작" Margin="35,0,25,0" Width="150" Height="100" Command="{Binding StartCommand}"/>
            <Button HorizontalAlignment="Stretch" Content="정지" Width="150" Height="100" Command="{Binding StopCommand}"/>
        </StackPanel>

        <StackPanel Grid.Column="1" Grid.RowSpan ="2">
            <Label Content="Log Message" FontSize="14" HorizontalAlignment="Center"/>
            <ListBox ItemsSource="{Binding LogMessages, Source={x:Static svc:LogManager.Instance}}">
                
            </ListBox>
        </StackPanel>
    </Grid>
</Page>
